{
  "name": "dsh-session-messaging",
  "version": "0.1.1",
  "private": true,
  "description": "Observable, durable coordination for DeepSeek Harness sessions",
  "repository": {
    "type": "git",
    "url": "https://github.com/AiraCometes/DSH-Session-Messaging.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "dsh": "0.2.1-rc.2"
  },
  "main": "src/plugin.js",
  "files": ["src", "cordis.patch.yml", "locale", "examples", "docs", "README.md"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "exports": {
    ".": "./src/plugin.js",
    "./core": "./src/core/index.js",
    "./http": "./src/http/server.js",
    "./adapters/harness": "./src/adapters/harness.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "test": "node --test",
    "demo": "node examples/demo.js",
    "check": "node scripts/check.js",
    "test:install": "node scripts/smoke-install.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dependencies": { "@deepseek-ai/schemastery": "3.18.5-alpha.2" },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  }
}
